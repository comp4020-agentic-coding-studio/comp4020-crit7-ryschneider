---
import { listSwaps } from "../lib/db";
import { COURSES, courseLabel } from "../lib/catalog";
import { UNI_ID_INPUT_PATTERN } from "../lib/uniId";
import "../styles.css";

const swaps = listSwaps();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tutorial swap board</title>
  </head>
  <body>
    <nav aria-label="site">
      <span class="brand">Swap board</span>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Tutorial &amp; lab swap board</h1>
      <p class="lede">
        Post the tutorial or lab slot you have and what you'd swap it for.
        Anyone else can claim it — once claimed, it's off the board for
        everyone else. New and claimed swaps appear live in every open tab.
      </p>

      <datalist id="course-options">
        {COURSES.map((course) => <option value={courseLabel(course)} />)}
      </datalist>

      <form method="post" action="/api/swaps" class="swap-form" id="swap-form">
        <div class="field">
          <label for="name">Uni ID</label>
          <input
            id="name"
            name="name"
            required
            maxlength="8"
            pattern={UNI_ID_INPUT_PATTERN}
            placeholder="u7509543"
            title="Uni ID, e.g. u7509543"
          />
        </div>

        <fieldset class="picker">
          <legend>Your tutorial</legend>
          <div class="field">
            <label for="course">Course</label>
            <input
              id="course"
              list="course-options"
              autocomplete="off"
              placeholder="Search for a course…"
              required
            />
          </div>
          <div class="field">
            <label for="tutorial">Tutorial</label>
            <select id="tutorial" disabled>
              <option value="">Choose a course first</option>
            </select>
          </div>
          <div class="field">
            <label for="week">Week</label>
            <select id="week" disabled>
              <option value="">Choose a tutorial first</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="picker timeslots">
          <legend>Swap</legend>
          <div class="field">
            <label for="have-timeslot">You have</label>
            <select id="have-timeslot" name="have" required disabled>
              <option value="">Choose a week first</option>
            </select>
          </div>
          <div class="field">
            <label for="want-timeslot">You want</label>
            <select id="want-timeslot" name="want" required disabled>
              <option value="">Choose a week first</option>
            </select>
          </div>
        </fieldset>

        <button class="submit">Post swap</button>
      </form>

      <ul id="swaps">
        {
          swaps.map((swap) => (
            <li data-swap-id={swap.id} class="swap-card">
              <p class="swap-summary">
                <strong>{swap.name}</strong> has {swap.have} — wants {swap.want}
              </p>
              {swap.claimedBy ? (
                <p class="claimed">claimed by {swap.claimedBy}</p>
              ) : (
                <form method="post" action={`/api/swaps/${swap.id}/claim`} class="claim-form">
                  <label for={`claim-${swap.id}`}>Uni ID</label>
                  <input
                    id={`claim-${swap.id}`}
                    name="claimedBy"
                    required
                    maxlength="8"
                    pattern={UNI_ID_INPUT_PATTERN}
                    placeholder="u7509543"
                    title="Uni ID, e.g. u7509543"
                  />
                  <button>Claim</button>
                </form>
              )}
            </li>
          ))
        }
      </ul>
    </main>
    <script>
      import {
        findCourse,
        findTutorial,
        findWeek,
        weekLabel,
        weekSessions,
        WEEKS,
        slotLabel,
        type Course,
        type Tutorial,
      } from "../lib/catalog";
      import { UNI_ID_INPUT_PATTERN } from "../lib/uniId";

      // The live half of the demo: subscribe to the SSE stream and update the
      // board as swaps are posted or claimed. Each form itself needs none of
      // this — its POST + redirect re-renders the submitting tab from
      // SQLite; this stream is how every other tab finds out.
      const list = document.querySelector("#swaps");

      function renderSwap(swap: {
        id: number;
        name: string;
        have: string;
        want: string;
        claimedBy: string | null;
      }) {
        const item = document.createElement("li");
        item.className = "swap-card";
        item.dataset.swapId = String(swap.id);

        const summary = document.createElement("p");
        summary.className = "swap-summary";
        const name = document.createElement("strong");
        name.textContent = swap.name;
        summary.append(name, ` has ${swap.have} — wants ${swap.want}`);
        item.append(summary);

        if (swap.claimedBy) {
          const claimed = document.createElement("p");
          claimed.className = "claimed";
          claimed.textContent = `claimed by ${swap.claimedBy}`;
          item.append(claimed);
        } else {
          const form = document.createElement("form");
          form.className = "claim-form";
          form.method = "post";
          form.action = `/api/swaps/${swap.id}/claim`;

          const label = document.createElement("label");
          label.htmlFor = `claim-${swap.id}`;
          label.textContent = "Uni ID";

          const input = document.createElement("input");
          input.id = `claim-${swap.id}`;
          input.name = "claimedBy";
          input.required = true;
          input.maxLength = 8;
          input.pattern = UNI_ID_INPUT_PATTERN;
          input.placeholder = "u7509543";
          input.title = "Uni ID, e.g. u7509543";

          const button = document.createElement("button");
          button.textContent = "Claim";

          form.append(label, input, button);
          item.append(form);
        }

        return item;
      }

      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const swap = JSON.parse(event.data);
        const existing = list?.querySelector(`[data-swap-id="${swap.id}"]`);
        const rendered = renderSwap(swap);
        if (existing) {
          existing.replaceWith(rendered);
        } else {
          list?.prepend(rendered);
        }
      });

      // Course → tutorial → week → timeslot cascade, all chosen ONCE: a swap
      // is between two sessions of the same tutorial in the same week, not
      // between different courses, tutorials or weeks, so a single course
      // input, tutorial select and week select feed both timeslot selects
      // below. A tutorial's timeslots are just its weekday sessions dated
      // into the chosen week (e.g. Mon/Wed/Thu), so they can't be shown
      // until a week is picked. Both timeslot <select>s carry a `name`
      // (`have`/`want`); their option values are the composed strings the
      // backend actually stores, so the rest of the app never needs to know
      // the catalog exists.
      const courseInput = document.querySelector<HTMLInputElement>("#course");
      const tutorialSelect =
        document.querySelector<HTMLSelectElement>("#tutorial");
      const weekSelect = document.querySelector<HTMLSelectElement>("#week");
      const haveSelect =
        document.querySelector<HTMLSelectElement>("#have-timeslot");
      const wantSelect =
        document.querySelector<HTMLSelectElement>("#want-timeslot");

      if (courseInput && tutorialSelect && weekSelect && haveSelect && wantSelect) {
        let course: Course | undefined;
        let tutorial: Tutorial | undefined;

        function resetTimeslots(placeholder: string) {
          for (const select of [haveSelect, wantSelect]) {
            select!.innerHTML = "";
            const option = document.createElement("option");
            option.value = "";
            option.textContent = placeholder;
            select!.append(option);
            select!.disabled = true;
          }
        }

        function resetWeek(placeholder: string) {
          weekSelect!.innerHTML = "";
          const option = document.createElement("option");
          option.value = "";
          option.textContent = placeholder;
          weekSelect!.append(option);
          weekSelect!.disabled = true;
          resetTimeslots("Choose a week first");
        }

        function resetTutorial(placeholder: string) {
          tutorialSelect!.innerHTML = "";
          const option = document.createElement("option");
          option.value = "";
          option.textContent = placeholder;
          tutorialSelect!.append(option);
          tutorialSelect!.disabled = true;
          resetWeek("Choose a tutorial first");
        }

        // A student can't offer and request the same dated timeslot, so
        // picking one on either side removes it from the other's options.
        function excludeFrom(source: HTMLSelectElement, other: HTMLSelectElement) {
          for (const opt of Array.from(other.options)) {
            opt.disabled = opt.value !== "" && opt.value === source.value;
          }
          if (other.value && other.value === source.value) {
            other.value = "";
          }
        }

        courseInput.addEventListener("input", () => {
          const matched = findCourse(courseInput.value);
          if (!matched) {
            course = undefined;
            resetTutorial("Choose a course first");
            return;
          }
          course = matched;
          tutorialSelect!.innerHTML = "";
          const placeholder = document.createElement("option");
          placeholder.value = "";
          placeholder.textContent = "Choose a tutorial";
          tutorialSelect!.append(placeholder);
          for (const t of matched.tutorials) {
            const option = document.createElement("option");
            option.value = t.name;
            option.textContent = t.name;
            tutorialSelect!.append(option);
          }
          tutorialSelect!.disabled = false;
          resetWeek("Choose a tutorial first");
        });

        tutorialSelect.addEventListener("change", () => {
          if (!course || !tutorialSelect!.value) {
            tutorial = undefined;
            resetWeek("Choose a tutorial first");
            return;
          }
          const matched = findTutorial(course, tutorialSelect!.value);
          if (!matched) {
            tutorial = undefined;
            resetWeek("Choose a tutorial first");
            return;
          }
          tutorial = matched;
          weekSelect!.innerHTML = "";
          const placeholder = document.createElement("option");
          placeholder.value = "";
          placeholder.textContent = "Choose a week";
          weekSelect!.append(placeholder);
          for (const week of WEEKS) {
            const option = document.createElement("option");
            option.value = String(week.number);
            option.textContent = weekLabel(week);
            weekSelect!.append(option);
          }
          weekSelect!.disabled = false;
          resetTimeslots("Choose a week first");
        });

        weekSelect.addEventListener("change", () => {
          if (!course || !tutorial || !weekSelect!.value) {
            resetTimeslots("Choose a week first");
            return;
          }
          const week = findWeek(Number(weekSelect!.value));
          if (!week) {
            resetTimeslots("Choose a week first");
            return;
          }
          const slots = weekSessions(tutorial, week);
          for (const select of [haveSelect, wantSelect]) {
            select!.innerHTML = "";
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = "Choose a timeslot";
            select!.append(placeholder);
            for (const slot of slots) {
              const option = document.createElement("option");
              option.value = slotLabel(course, tutorial, week, slot);
              option.textContent = slot.value;
              select!.append(option);
            }
            select!.disabled = false;
          }
        });

        haveSelect.addEventListener("change", () => excludeFrom(haveSelect!, wantSelect!));
        wantSelect.addEventListener("change", () => excludeFrom(wantSelect!, haveSelect!));
      }
    </script>
  </body>
</html>
